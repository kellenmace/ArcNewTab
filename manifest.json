{
  "manifest_version": 3,
  "name": "Arc Command Bar",
  "version": "1.0.0",
  "description": "Replaces the generic new tab page with an Arc browser-style command bar.",
  "permissions": ["tabs", "history", "topSites", "activeTab"],
  "icons": {
    "16": "arc.png",
    "48": "arc.png",
    "128": "arc.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "show-command-bar": {
      "suggested_key": {
        "default": "Ctrl+T",
        "mac": "Command+T"
      },
      "description": "Show search overlay"
    }
  }
}
